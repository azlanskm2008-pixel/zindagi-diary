const app=document.querySelector('#app'), enc=new TextEncoder(),dec=new TextDecoder();let db,key,entries={},month=new Date(),saveTimer;
function openDB(){return new Promise((ok,no)=>{let r=indexedDB.open('zindagi-vault',1);r.onupgradeneeded=()=>r.result.createObjectStore('data');r.onsuccess=()=>{db=r.result;ok()};r.onerror=()=>no(r.error)})}function get(){return new Promise((ok,no)=>{let r=db.transaction('data').objectStore('data').get('vault');r.onsuccess=()=>ok(r.result);r.onerror=()=>no(r.error)})}function put(v){return new Promise((ok,no)=>{let t=db.transaction('data','readwrite');t.objectStore('data').put(v,'vault');t.oncomplete=ok;t.onerror=()=>no(t.error)})}
async function derive(p,s){let m=await crypto.subtle.importKey('raw',enc.encode(p),'PBKDF2',false,['deriveKey']);return crypto.subtle.deriveKey({name:'PBKDF2',salt:s,iterations:310000,hash:'SHA-256'},m,{name:'AES-GCM',length:256},false,['encrypt','decrypt'])}async function save(){let iv=crypto.getRandomValues(new Uint8Array(12)),c=await crypto.subtle.encrypt({name:'AES-GCM',iv},key,enc.encode(JSON.stringify(entries)));await put({iv:[...iv],cipher:[...new Uint8Array(c)]})}async function unlock(first){let p=document.querySelector('#pw').value,err=document.querySelector('#err');if(p.length<8){err.textContent='Use at least 8 characters.';return}if(first&&p!==document.querySelector('#pw2').value){err.textContent='Passwords do not match.';return}try{let salt=first?crypto.getRandomValues(new Uint8Array(16)):new Uint8Array(JSON.parse(localStorage.zindagiSalt));key=await derive(p,salt);if(first){entries={};await save();localStorage.zindagiSalt=JSON.stringify([...salt])}else{let x=await get(),plain=await crypto.subtle.decrypt({name:'AES-GCM',iv:new Uint8Array(x.iv)},key,new Uint8Array(x.cipher));entries=JSON.parse(dec.decode(plain))}calendar()}catch(e){key=null;err.textContent='Password did not unlock this diary.'}}
function gate(first){app.innerHTML=`<div class="center"><section class="panel"><p class="brand">Zindagi.</p><div class="tag">Your life. Your thoughts. Your story.</div><h2>${first?'Create your private diary':'Welcome back.'}</h2><p class="muted">${first?'Choose a password to encrypt your diary.':'Enter your password to unlock your diary.'}</p><input id="pw" type="password" placeholder="${first?'Create password':'Password'}">${first?'<input id="pw2" type="password" placeholder="Confirm password">':''}<button class="primary" id="go">${first?'Create my diary':'Unlock Zindagi'}</button><div id="err" class="error"></div><p class="muted" style="font-size:12px">Entries are encrypted and stored in this browser on this device. If you forget your password, they cannot be recovered. Keep your password safe.</p></section></div>`;document.querySelector('#go').onclick=()=>unlock(first);document.querySelector('#pw').onkeydown=e=>{if(e.key==='Enter')unlock(first)}}
const keyDate=(y,m,d)=>`${y}-${String(m+1).padStart(2,'0')}-${String(d).padStart(2,'0')}`;function pretty(k){return new Date(k+'T12:00:00').toLocaleDateString('en-IN',{weekday:'long',day:'numeric',month:'long',year:'numeric'})}function calendar(){let y=month.getFullYear(),m=month.getMonth(),start=new Date(y,m,1).getDay(),n=new Date(y,m+1,0).getDate(),now=new Date(),cells='';for(let i=0;i<start;i++)cells+='<div class="day blank"></div>';for(let d=1;d<=n;d++){let k=keyDate(y,m,d),today=y===now.getFullYear()&&m===now.getMonth()&&d===now.getDate();cells+=`<button class="day ${entries[k]?'entry':''} ${today?'today':''}" data-k="${k}">${d}</button>`}app.innerHTML=`<header><div class="logo">Zindagi.</div><button class="ghost" id="lock">Lock diary</button></header><main><div class="eyebrow">A private space for you</div><h1>Your days, your stories.</h1><p class="intro">Choose a date to write something worth remembering.</p><section class="calendar"><div class="monthbar"><div class="month">${month.toLocaleDateString('en-IN',{month:'long',year:'numeric'})}</div><div><button id="prev">‹</button><button id="next">›</button></div></div><div class="grid">${['SUN','MON','TUE','WED','THU','FRI','SAT'].map(x=>`<div class="weekday">${x}</div>`).join('')}${cells}</div><div class="foot">● Days with an entry &nbsp; · &nbsp; Choose any date to begin</div></section></main>`;document.querySelectorAll('[data-k]').forEach(b=>b.onclick=()=>editor(b.dataset.k));document.querySelector('#prev').onclick=()=>{month=new Date(y,m-1,1);calendar()};document.querySelector('#next').onclick=()=>{month=new Date(y,m+1,1);calendar()};document.querySelector('#lock').onclick=()=>{key=null;entries={};gate(false)}}
function esc(s){return String(s||'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]))}function editor(k){let e=entries[k]||{title:'',body:''};app.innerHTML=`<header><div class="logo">Zindagi.</div><button class="ghost" id="lock">Lock diary</button></header><main class="editor"><button class="back" id="back">← &nbsp; Back to calendar</button><div class="date-label">A page from your life</div><h1 class="date-title">${pretty(k)}</h1><input id="title" class="title" maxlength="100" placeholder="Give this day a title (optional)" value="${esc(e.title)}"><textarea id="body" class="body" placeholder="Dear Diary,\n\nWrite whatever is on your mind...">${esc(e.body)}</textarea><div class="status"><span id="saved">Saved on this device</span><span id="words">${e.body.trim()?e.body.trim().split(/\s+/).length:0} words</span></div></main>`;document.querySelector('#back').onclick=()=>{month=new Date(+k.slice(0,4),+k.slice(5,7)-1,1);calendar()};document.querySelector('#lock').onclick=()=>{key=null;entries={};gate(false)};function changed(){let body=document.querySelector('#body').value,title=document.querySelector('#title').value;document.querySelector('#words').textContent=(body.trim()?body.trim().split(/\s+/).length:0)+' words';document.querySelector('#saved').textContent='Saving…';clearTimeout(saveTimer);saveTimer=setTimeout(async()=>{if(body.trim()||title.trim())entries[k]={body,title};else delete entries[k];try{await save();document.querySelector('#saved').textContent='Saved on this device'}catch{document.querySelector('#saved').textContent='Save failed — keep page open'}},400)}document.querySelector('#body').oninput=changed;document.querySelector('#title').oninput=changed}
(async()=>{if(!crypto.subtle||!indexedDB){app.textContent='Please open Zindagi in a modern browser.';return}await openDB();gate( !(localStorage.zindagiSalt&&await get()) )})();
</script><script>if('serviceWorker'in navigator)addEventListener('load',()=>navigator.serviceWorker.register('./sw.js').catch(()=>{}));</script></body></html>

