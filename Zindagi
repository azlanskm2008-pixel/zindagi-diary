<style>
*{box-sizing:border-box}body{margin:0;background:#f6f7f8;color:#202124;font-family:Inter,Arial,sans-serif}button,input,textarea{font:inherit}button{cursor:pointer}.center{min-height:100vh;display:grid;place-items:center;padding:24px}.panel{background:white;border:1px solid #e8e9eb;border-radius:20px;padding:34px;width:min(420px,100%);box-shadow:0 12px 40px #00000008}.brand{font:40px Georgia,serif;margin:0 0 8px}.muted{color:#777;font-size:14px;line-height:1.6}.tag{font-size:11px;letter-spacing:1.5px;color:#888;text-transform:uppercase}h2{font-size:19px;margin:30px 0 8px}input{width:100%;padding:14px;border:1px solid #e5e6e8;border-radius:9px;outline:none;margin-top:10px}input:focus,textarea:focus{border-color:#999}.primary{width:100%;padding:14px;background:#202124;color:#fff;border:0;border-radius:9px;margin-top:12px}.error{color:#b44;font-size:13px;min-height:18px;margin-top:10px}header{height:72px;background:white;border-bottom:1px solid #e8e9eb;display:flex;align-items:center;justify-content:space-between;padding:0 max(5vw,24px)}.logo{font:27px Georgia,serif}.ghost{border:1px solid #e5e6e8;background:white;border-radius:9px;padding:9px 13px;color:#555}main{max-width:960px;margin:auto;padding:52px 26px}.eyebrow,.date-label{font-size:11px;letter-spacing:1.7px;color:#92969b;text-transform:uppercase}h1{font:42px Georgia,serif;margin:10px 0}.intro{color:#777;margin:0 0 32px}.calendar{background:#fff;border:1px solid #e8e9eb;border-radius:16px;padding:26px;max-width:690px}.monthbar{display:flex;justify-content:space-between;align-items:center;margin-bottom:22px}.month{font:23px Georgia,serif}.monthbar button{border:1px solid #e8e9eb;background:white;border-radius:50%;width:36px;height:36px;margin-left:6px;font-size:18px}.grid{display:grid;grid-template-columns:repeat(7,1fr);gap:6px}.weekday{text-align:center;color:#999;font-size:11px;padding:8px}.day{height:54px;border:0;background:transparent;border-radius:10px;position:relative}.day:hover{background:#f1f2f3}.day.tod